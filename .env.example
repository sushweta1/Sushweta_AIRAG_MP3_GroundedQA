# MP3 Grounded Q&A — Environment Configuration

# OpenAI credentials
# Vocareum may provision these automatically.
# OPENAI_API_KEY=your_openai_api_key

# Option 1: Persistent local Qdrant
QDRANT_LOCAL_PATH=./qdrant_storage

# Option 2: Remote Qdrant
# Comment out QDRANT_LOCAL_PATH before using remote Qdrant.
# QDRANT_URL=https://your-cluster.qdrant.io
# QDRANT_API_KEY=your_qdrant_api_key

# Optimized retrieval configuration
RETRIEVAL_K=7
RETRIEVAL_THRESHOLD=0.30
QDRANT_TIMEOUT=30
